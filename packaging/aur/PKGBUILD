_widgets=(
  "KdeControlStation|kde-control-station-$_kcs_commit|package"
  "com.github.N0repi.compactclock|kde-compact-clock-$_clock_commit|."
  "org.kde.plasma.dockio|plasmoid-dockio-$_dockio_commit|package"
  "com.github.itayavra.batterywatch|batterywatch-$_battery_commit|."
  "com.github.lukk17.aiusage|ai-usage-widget-$_aiusage_commit|package"
)

_frosty_root() {
  printf '%s\n' "$srcdir/$pkgname-$pkgver"
}

_gtk_theme() {
  local root
  root=$(_frosty_root)
  "$root/packaging/gtk-theme.sh" "$1" "$root/vendor/color-scheme/Frosty.colors" "${@:2}"
}

_copy_tree() {
  cp -r -- "$1" "$2"
  chmod -R u=rwX,go=rX "$2"
}

prepare() {
  local battery="$srcdir/batterywatch-$_battery_commit/contents"
  rm -rf -- "$battery/screenshots" "$battery/bin/tests"
  find "$battery" -name '*.test.*' -delete
}

build() {
  local root
  root=$(_frosty_root)

  cmake -B build -S "$root/vendor/style" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -DBUILD_QT6=ON \
    -DBUILD_QT5=OFF \
    -Wno-dev
  cmake --build build

  _gtk_theme build "$srcdir/breeze-gtk-$_breeze_gtk_ver" "$srcdir/gtk-theme"
}

check() {
  _gtk_theme check "$srcdir/gtk-theme"
}

package() {
  local root share doc changes component widget id from dir
  root=$(_frosty_root)
  share="$pkgdir/usr/share"
  doc="$share/doc/$pkgname"

  DESTDIR="$pkgdir" cmake --install build
  rm -rf -- "$pkgdir/usr/lib/cmake"

  install -dm755 "$share/plasma/desktoptheme" "$share/plasma/look-and-feel" "$share/icons" "$share/themes" "$pkgdir/var/lib/flatpak/extension/org.gtk.Gtk3theme.Frosty-Dark/$CARCH"

  _copy_tree "$root/vendor/plasma-style/frosty" "$share/plasma/desktoptheme/frosty"
  install -Dm644 "$root/vendor/color-scheme/Frosty.colors" "$share/color-schemes/Frosty.colors"

  _copy_tree "$root/look-and-feel/com.github.lukk17.frosty" "$share/plasma/look-and-feel/com.github.lukk17.frosty"
  install -Dm644 "$root/vendor/color-scheme/Frosty.colors" "$share/plasma/look-and-feel/com.github.lukk17.frosty/contents/colors"

  _copy_tree "$root/vendor/icons/frosty" "$share/icons/frosty"
  _copy_tree "$root/vendor/cursors/Sweet-cursors" "$share/icons/Sweet-cursors"

  install -Dm644 "$root/konsole/Frosty.profile" "$share/konsole/Frosty.profile"
  install -Dm644 "$root/vendor/konsole/Frosty Green.colorscheme" "$share/konsole/Frosty Green.colorscheme"
  install -Dm644 -t "$pkgdir/etc/xdg" "$root/xdg/dolphinrc" "$root/xdg/konsolerc"
  install -Dm755 "$root/bin/frosty-setup" "$pkgdir/usr/bin/frosty-setup"
  install -Dm644 "$root/lib/restore-widget-settings.js" "$share/frosty/restore-widget-settings.js"

  _copy_tree "$srcdir/gtk-theme/Frosty-Dark" "$share/themes/Frosty-Dark"
  _copy_tree "$srcdir/gtk-theme/flatpak" "$pkgdir/var/lib/flatpak/extension/org.gtk.Gtk3theme.Frosty-Dark/$CARCH/3.22"
  install -Dm755 "$root/flatpak/frosty-flatpak-gtk" "$pkgdir/usr/lib/frosty/frosty-flatpak-gtk"
  install -Dm644 "$root/flatpak/frosty-flatpak-gtk.hook" "$share/libalpm/hooks/frosty-flatpak-gtk.hook"
  install -Dm644 "$root/kconf_update/frosty.upd" "$share/kconf_update/frosty.upd"
  install -Dm755 "$root/kconf_update/frosty-gtk-theme.sh" "$share/kconf_update/frosty-gtk-theme.sh"

  for widget in "${_widgets[@]}"; do
    IFS='|' read -r id from dir <<< "$widget"
    install -Dm644 "$srcdir/$from/$dir/metadata.json" "$share/plasma/plasmoids/$id/metadata.json"
    _copy_tree "$srcdir/$from/$dir/contents" "$share/plasma/plasmoids/$id/contents"
    install -Dm644 "$srcdir/$from/LICENSE" "$share/licenses/$pkgname/widgets/$id/LICENSE"
  done
  install -Dm644 "$srcdir/kde-compact-clock-$_clock_commit/CREDITS.md" "$share/licenses/$pkgname/widgets/com.github.N0repi.compactclock/CREDITS.md"

  install -Dm644 -t "$share/licenses/$pkgname" "$root"/LICENSES/GPL-*.txt "$root"/LICENSES/LGPL-*.txt "$srcdir/LGPL-2.0-or-later.txt" "$srcdir/LGPL-2.1-or-later.txt" "$root/CREDITS.md"
  install -Dm644 "$root/vendor/style/LICENSE.MIT" "$share/licenses/$pkgname/MIT.txt"

  install -Dm644 "$root/CHANGES.md" "$doc/CHANGES.md"
  install -Dm644 "$root/look-and-feel/CHANGES.md" "$doc/look-and-feel/CHANGES.md"
  for changes in "$root"/vendor/*/CHANGES.md; do
    component=${changes%/CHANGES.md}
    component=${component##*/}
    install -Dm644 "$changes" "$doc/$component/CHANGES.md"
  done
}
