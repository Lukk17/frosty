pkgbase = frosty
	pkgdesc = Frosted glass theme for KDE Plasma 6: Plasma Style, colors, application style, window decoration, icons, cursors, panel layout and Konsole and Dolphin defaults
	pkgver = 0.0.1
	pkgrel = 1
	url = https://github.com/Lukk17/frosty
	install = packaging/aur/frosty.install
	arch = x86_64
	license = GPL-3.0-only
	license = GPL-3.0-or-later
	license = GPL-2.0-or-later
	license = LGPL-3.0-or-later
	license = LGPL-3.0-only
	license = MIT
	makedepends = cmake
	makedepends = extra-cmake-modules
	depends = bash
	depends = frameworkintegration
	depends = hicolor-icon-theme
	depends = kcmutils
	depends = kcolorscheme
	depends = kconfig
	depends = kconfigwidgets
	depends = kcoreaddons
	depends = kdecoration
	depends = kguiaddons
	depends = ki18n
	depends = kiconthemes
	depends = kirigami
	depends = konsave
	depends = kwidgetsaddons
	depends = kwindowsystem
	depends = libplasma
	depends = plasma-workspace
	depends = plasma6-applets-appgrid
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-tools
	options = !emptydirs
	backup = etc/xdg/dolphinrc
	backup = etc/xdg/konsolerc

pkgname = frosty
